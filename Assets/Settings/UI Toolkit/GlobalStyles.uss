.button {
    width: 200px;
    height: 50px;
    background-color: rgba(255, 255, 255, 0);
    border-width: 0;
    border-radius: 15px;
    transition-property: background-color, border-width, font-size, color;
    transition-duration: 0.134s;
    transition-timing-function: ease-in-sine;
    font-size: 24px;
    color: white;
}

.button:hover {
    width: 200px;
    height: 50px;
    background-color: rgb(128, 128, 128);
    border-width: 5px;
    font-size: 32px;
    color: black;
}

.button:focus {
    border-color: gray;
}

.button:active {
    background-color: rgb(191, 191, 191);
}


