.hud__container {
	width: 100%;
	height: 100%;
}

.hud__health {
	width: 300px;
	margin: 10px;
}

.hud__health__bar {
	margin: 0px;
	padding: 0px;
}

.hud__health__label {
	color: white;
	margin: 0px;
	padding: 0px;
}

.hud__statistics__container {
	position: absolute;
	/* width: 400px; */
	margin: 10px;
	right: 0px;
}

.hud__statistics__element {
	flex-direction: row;
	justify-content: space-between;
}

.hud__experience {
	position: absolute;
	width: 90%;
	bottom: 15px;
	align-items: stretch;
	align-self: center;
}